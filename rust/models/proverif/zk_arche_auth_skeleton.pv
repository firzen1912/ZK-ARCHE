(* ZK-ARCHE synchronized symbolic AUTH model.
   Scope: current full AUTH_1 -> AUTH_2 -> AUTH_3 -> AUTH_ACK semantics.
   The model abstracts elliptic-curve groups and the custom role proof.
   It is not a computational proof of Schnorr or role-membership security. *)

free c: channel.
free auth_ack: bitstring.
free server_finished_label: bitstring.
free client_finished_label: bitstring.

type skey.
type pkey.
type nonce.
type sesskey.
type role.
type sessionid.

fun pk(skey): pkey.
fun dh(skey, pkey): sesskey.
equation forall x:skey, y:skey; dh(x, pk(y)) = dh(y, pk(x)).

fun kdf(sesskey, nonce, nonce, bitstring): sesskey.
fun hmac(sesskey, bitstring): bitstring.

fun pid(pkey, nonce, pkey, pkey): bitstring.
fun replay_key(bitstring, nonce, pkey): bitstring.
fun client_auth_context(bitstring, nonce, pkey): bitstring.
fun server_auth_context(nonce, pkey): bitstring.
fun role_context(role, bitstring, nonce, pkey): bitstring.
fun kc_context(bitstring, bitstring, nonce, pkey, pkey, bitstring, nonce, pkey): bitstring.

fun schnorr_proof(skey, bitstring): bitstring.
fun role_proof(role, bitstring): bitstring.

reduc forall x:skey, ctx:bitstring;
  verify_schnorr(pk(x), ctx, schnorr_proof(x, ctx)) = true.
reduc forall r:role, ctx:bitstring;
  verify_role(r, ctx, role_proof(r, ctx)) = true.

(* Persistent replay state models the production invariant:
   - derive a replay key from AUTH_1 identity material,
   - reject a key that is already present,
   - insert only after full AUTH_1 verification succeeds.
   The concrete C server serializes contains -> verify -> insert with replay_mu;
   Rust provides the corresponding replay-cache behavior. ProVerif tables are
   persistent but their failed lookups are over-approximated by the verifier,
   so an injective query may remain inconclusive even when this transition is
   faithfully represented. Retained tool output must distinguish that tool
   limitation from a concrete implementation defect. *)
table replay_seen(bitstring).

(* Pre-existing trust and authorization observations. AUTH never emits a
   trust-mutation event in this model. *)
event TrustedRecordPresent(pkey).
event ClientAuth1Sent(pkey, pkey, sessionid, bitstring).
event ReplayRejected(pkey, pkey, sessionid, bitstring).
event ReplayRecorded(pkey, pkey, sessionid, bitstring).
event ServerAuth1Accepted(pkey, pkey, sessionid, bitstring).
event AuthorizationChecked(pkey, role, sessionid, bitstring).
event ServerAuth2Sent(pkey, pkey, sessionid, bitstring).
event ClientAuth3Sent(pkey, pkey, sessionid, bitstring).
event ClientComplete(pkey, pkey, sessionid, bitstring).
event ServerComplete(pkey, pkey, sessionid, bitstring).

(* FM-04: injective agreement / replay resistance. The model now contains the
   accepted-AUTH replay state transition. ProVerif may still over-approximate
   a failed table lookup and therefore fail to establish injectivity; such a
   result is not equivalent to an executable replay bypass. *)
query cpk:pkey, spk:pkey, sid:sessionid, a1ctx:bitstring;
  inj-event(ServerAuth1Accepted(cpk, spk, sid, a1ctx))
  ==> inj-event(ClientAuth1Sent(cpk, spk, sid, a1ctx)).

query cpk:pkey, spk:pkey, sid:sessionid, a1ctx:bitstring;
  event(ServerAuth1Accepted(cpk, spk, sid, a1ctx))
  ==> event(ReplayRecorded(cpk, spk, sid, a1ctx)).

query cpk:pkey, spk:pkey, sid:sessionid, kcctx:bitstring;
  inj-event(ServerComplete(cpk, spk, sid, kcctx))
  ==> inj-event(ClientAuth3Sent(cpk, spk, sid, kcctx)).

(* FM-05: agreement on the currently implemented AUTH key-confirmation
   context. This does not yet claim binding for profile/capability/audience
   fields that are not in the concrete KC transcript. *)
query cpk:pkey, spk:pkey, sid:sessionid, kcctx:bitstring;
  event(ClientComplete(cpk, spk, sid, kcctx))
  ==> event(ServerAuth2Sent(cpk, spk, sid, kcctx)).

query cpk:pkey, spk:pkey, sid:sessionid, kcctx:bitstring;
  event(ServerComplete(cpk, spk, sid, kcctx))
  ==> event(ClientAuth3Sent(cpk, spk, sid, kcctx)).

(* FM-09: successful server-side AUTH is relative to pre-existing trusted
   state and an explicit authorization check. Normal AUTH has no modeled
   transition that inserts or expands trusted state. *)
query cpk:pkey, spk:pkey, sid:sessionid, kcctx:bitstring;
  event(ServerComplete(cpk, spk, sid, kcctx))
  ==> event(TrustedRecordPresent(cpk)).

let Client(csk:skey, spk:pkey, allowed:role) =
  new sid:sessionid;
  new nc:nonce;
  new ce:skey;
  let cpk = pk(csk) in
  let ephc = pk(ce) in
  let p = pid(cpk, nc, ephc, spk) in
  let a1ctx = client_auth_context(p, nc, ephc) in
  let cpf = schnorr_proof(csk, a1ctx) in
  let rctx = role_context(allowed, p, nc, ephc) in
  event ClientAuth1Sent(cpk, spk, sid, a1ctx);
  out(c, (sid, cpk, p, nc, ephc, cpf, role_proof(allowed, rctx)));

  in(c, (=sid, ns:nonce, ephs:pkey, server_pf:bitstring, tagS:bitstring));
  let sctx = server_auth_context(ns, ephs) in
  if verify_schnorr(spk, sctx, server_pf) = true then
    let shared = dh(ce, ephs) in
    let kcctx = kc_context(p, cpf, nc, ephc, spk, server_pf, ns, ephs) in
    let k = kdf(shared, nc, ns, kcctx) in
    if tagS = hmac(k, (server_finished_label, kcctx)) then
      let tagC = hmac(k, (client_finished_label, kcctx)) in
      event ClientAuth3Sent(cpk, spk, sid, kcctx);
      out(c, (sid, tagC));
      in(c, (=sid, ack:bitstring));
      if ack = auth_ack then
        event ClientComplete(cpk, spk, sid, kcctx).

let Server(ssk:skey, trusted_cpk:pkey, allowed:role) =
  let spk = pk(ssk) in
  in(c, (sid:sessionid, cpk:pkey, p:bitstring, nc:nonce, ephc:pkey,
         cpf:bitstring, rpf:bitstring));
  let rk = replay_key(p, nc, ephc) in
  get replay_seen(=rk) in
    event ReplayRejected(cpk, spk, sid, rk)
  else
    if cpk = trusted_cpk then
      let expected_pid = pid(cpk, nc, ephc, spk) in
      if p = expected_pid then
        let a1ctx = client_auth_context(p, nc, ephc) in
        if verify_schnorr(cpk, a1ctx, cpf) = true then
          let rctx = role_context(allowed, p, nc, ephc) in
          if verify_role(allowed, rctx, rpf) = true then
            insert replay_seen(rk);
            event ReplayRecorded(cpk, spk, sid, a1ctx);
            event ServerAuth1Accepted(cpk, spk, sid, a1ctx);
            event AuthorizationChecked(cpk, allowed, sid, a1ctx);
            new ns:nonce;
            new se:skey;
            let ephs = pk(se) in
            let sctx = server_auth_context(ns, ephs) in
            let server_pf = schnorr_proof(ssk, sctx) in
            let shared = dh(se, ephc) in
            let kcctx = kc_context(p, cpf, nc, ephc, spk, server_pf, ns, ephs) in
            let k = kdf(shared, nc, ns, kcctx) in
            let tagS = hmac(k, (server_finished_label, kcctx)) in
            event ServerAuth2Sent(cpk, spk, sid, kcctx);
            out(c, (sid, ns, ephs, server_pf, tagS));
            in(c, (=sid, tagC:bitstring));
            if tagC = hmac(k, (client_finished_label, kcctx)) then
              event ServerComplete(cpk, spk, sid, kcctx);
              out(c, (sid, auth_ack)).

process
  new csk:skey;
  new ssk:skey;
  new allowed:role;
  let cpk = pk(csk) in
  event TrustedRecordPresent(cpk);
  ((!Client(csk, pk(ssk), allowed)) | (!Server(ssk, cpk, allowed)))
