(* ZK-ARCHE draft AUTH v3 symbolic model.
   Scope: ADR 0001 candidate AUTH_1 -> AUTH_2 -> AUTH_3 -> authenticated AUTH_ACK.
   This model is non-normative and non-advertised. It abstracts elliptic-curve
   groups, the custom role proof, canonical hashing, and concrete byte encoding.
   It is not a computational proof of Schnorr or role-membership security. *)

free c: channel.
free protocol_v3: bitstring.
free suite_core: bitstring.
free profile_core: bitstring.
free capabilities_core: bitstring.
free authz_core: bitstring.
free critical_extensions_core: bitstring.
free channel_binding_core: bitstring.
free server_finished_v3_label: bitstring.
free client_finished_v3_label: bitstring.
free server_complete_v3_label: bitstring.

type skey.
type pkey.
type nonce.
type sesskey.
type role.
type sessionid.

fun pk(skey): pkey.
fun dh(skey, pkey): sesskey.
equation forall x:skey, y:skey; dh(x, pk(y)) = dh(y, pk(x)).

fun pid(pkey, nonce, pkey, pkey): bitstring.
fun replay_key(bitstring, nonce, pkey): bitstring.
fun client_auth_context(bitstring, nonce, pkey): bitstring.
fun server_auth_context(nonce, pkey): bitstring.
fun role_context(role, bitstring, nonce, pkey): bitstring.
fun kc_context_v2(bitstring, bitstring, nonce, pkey, pkey, bitstring, nonce, pkey): bitstring.

fun security_context_v3(
  bitstring, bitstring, bitstring, bitstring, sessionid,
  bitstring, bitstring, bitstring): bitstring.
fun kc_context_v3(bitstring, bitstring): bitstring.

fun k_s2c_v3(sesskey, bitstring): sesskey.
fun k_c2s_v3(sesskey, bitstring): sesskey.
fun k_complete_v3(sesskey, bitstring): sesskey.
fun hmac(sesskey, bitstring): bitstring.
fun completion_hash_v3(bitstring, bitstring): bitstring.

fun schnorr_proof(skey, bitstring): bitstring.
fun role_proof(role, bitstring): bitstring.

reduc forall x:skey, ctx:bitstring;
  verify_schnorr(pk(x), ctx, schnorr_proof(x, ctx)) = true.
reduc forall r:role, ctx:bitstring;
  verify_role(r, ctx, role_proof(r, ctx)) = true.

table replay_seen_v3(bitstring).

event TrustedRecordPresent(pkey).
event ClientAuth1SentV3(pkey, pkey, sessionid, bitstring, bitstring).
event ReplayRejectedV3(pkey, pkey, sessionid, bitstring).
event ReplayRecordedV3(pkey, pkey, sessionid, bitstring).
event ServerAuth1AcceptedV3(pkey, pkey, sessionid, bitstring, bitstring).
event AuthorizationCheckedV3(pkey, role, sessionid, bitstring).
event ServerAuth2SentV3(pkey, pkey, sessionid, bitstring, bitstring).
event ClientAuth3SentV3(pkey, pkey, sessionid, bitstring, bitstring).
event ServerCompleteV3(pkey, pkey, sessionid, bitstring, bitstring).
event ClientCompleteV3(pkey, pkey, sessionid, bitstring, bitstring).

query cpk:pkey, spk:pkey, sid:sessionid, secctx:bitstring, a1ctx:bitstring;
  event(ServerAuth1AcceptedV3(cpk, spk, sid, secctx, a1ctx))
  ==> event(ReplayRecordedV3(cpk, spk, sid, a1ctx)).

query cpk:pkey, spk:pkey, sid:sessionid, secctx:bitstring, kcctx:bitstring;
  inj-event(ServerCompleteV3(cpk, spk, sid, secctx, kcctx))
  ==> inj-event(ClientAuth3SentV3(cpk, spk, sid, secctx, kcctx)).

query cpk:pkey, spk:pkey, sid:sessionid, secctx:bitstring, kcctx:bitstring;
  inj-event(ClientCompleteV3(cpk, spk, sid, secctx, kcctx))
  ==> inj-event(ServerCompleteV3(cpk, spk, sid, secctx, kcctx)).

query cpk:pkey, spk:pkey, sid:sessionid, secctx:bitstring, kcctx:bitstring;
  event(ClientCompleteV3(cpk, spk, sid, secctx, kcctx))
  ==> event(ServerAuth2SentV3(cpk, spk, sid, secctx, kcctx)).

query cpk:pkey, spk:pkey, sid:sessionid, secctx:bitstring, kcctx:bitstring;
  event(ServerCompleteV3(cpk, spk, sid, secctx, kcctx))
  ==> event(ClientAuth3SentV3(cpk, spk, sid, secctx, kcctx)).

query cpk:pkey, spk:pkey, sid:sessionid, secctx:bitstring, kcctx:bitstring;
  event(ServerCompleteV3(cpk, spk, sid, secctx, kcctx))
  ==> event(TrustedRecordPresent(cpk)).

let ClientV3(csk:skey, spk:pkey, allowed:role) =
  new sid:sessionid;
  new nc:nonce;
  new ce:skey;
  let cpk = pk(csk) in
  let ephc = pk(ce) in
  let p = pid(cpk, nc, ephc, spk) in
  let a1ctx = client_auth_context(p, nc, ephc) in
  let cpf = schnorr_proof(csk, a1ctx) in
  let rctx = role_context(allowed, p, nc, ephc) in
  let secctx = security_context_v3(
    protocol_v3, suite_core, profile_core, capabilities_core, sid,
    authz_core, critical_extensions_core, channel_binding_core) in
  event ClientAuth1SentV3(cpk, spk, sid, secctx, a1ctx);
  out(c, (sid,
          protocol_v3, suite_core, profile_core, capabilities_core,
          authz_core, critical_extensions_core, channel_binding_core,
          cpk, p, nc, ephc, cpf, role_proof(allowed, rctx)));

  in(c, (=sid, ns:nonce, ephs:pkey, server_pf:bitstring, tagS:bitstring));
  let sctx = server_auth_context(ns, ephs) in
  if verify_schnorr(spk, sctx, server_pf) = true then
    let shared = dh(ce, ephs) in
    let base_kc = kc_context_v2(p, cpf, nc, ephc, spk, server_pf, ns, ephs) in
    let kcctx = kc_context_v3(secctx, base_kc) in
    let k_s2c = k_s2c_v3(shared, kcctx) in
    let k_c2s = k_c2s_v3(shared, kcctx) in
    let k_complete = k_complete_v3(shared, kcctx) in
    if tagS = hmac(k_s2c, (server_finished_v3_label, kcctx)) then
      let tagC = hmac(k_c2s, (client_finished_v3_label, kcctx)) in
      event ClientAuth3SentV3(cpk, spk, sid, secctx, kcctx);
      out(c, (sid, tagC));
      in(c, (=sid, tagAck:bitstring));
      let completion = completion_hash_v3(kcctx, tagC) in
      if tagAck = hmac(k_complete, (server_complete_v3_label, completion)) then
        event ClientCompleteV3(cpk, spk, sid, secctx, kcctx).

let ServerV3(ssk:skey, trusted_cpk:pkey, allowed:role) =
  let spk = pk(ssk) in
  in(c, (sid:sessionid,
         version_in:bitstring, suite_in:bitstring, profile_in:bitstring,
         capabilities_in:bitstring, authz_in:bitstring,
         critical_extensions_in:bitstring, channel_binding_in:bitstring,
         cpk:pkey, p:bitstring, nc:nonce, ephc:pkey,
         cpf:bitstring, rpf:bitstring));
  let secctx = security_context_v3(
    version_in, suite_in, profile_in, capabilities_in, sid,
    authz_in, critical_extensions_in, channel_binding_in) in
  let rk = replay_key(p, nc, ephc) in
  get replay_seen_v3(=rk) in
    event ReplayRejectedV3(cpk, spk, sid, rk)
  else
    if cpk = trusted_cpk then
      let expected_pid = pid(cpk, nc, ephc, spk) in
      if p = expected_pid then
        let a1ctx = client_auth_context(p, nc, ephc) in
        if verify_schnorr(cpk, a1ctx, cpf) = true then
          let rctx = role_context(allowed, p, nc, ephc) in
          if verify_role(allowed, rctx, rpf) = true then
            insert replay_seen_v3(rk);
            event ReplayRecordedV3(cpk, spk, sid, a1ctx);
            event ServerAuth1AcceptedV3(cpk, spk, sid, secctx, a1ctx);
            event AuthorizationCheckedV3(cpk, allowed, sid, secctx);
            new ns:nonce;
            new se:skey;
            let ephs = pk(se) in
            let sctx = server_auth_context(ns, ephs) in
            let server_pf = schnorr_proof(ssk, sctx) in
            let shared = dh(se, ephc) in
            let base_kc = kc_context_v2(p, cpf, nc, ephc, spk, server_pf, ns, ephs) in
            let kcctx = kc_context_v3(secctx, base_kc) in
            let k_s2c = k_s2c_v3(shared, kcctx) in
            let k_c2s = k_c2s_v3(shared, kcctx) in
            let k_complete = k_complete_v3(shared, kcctx) in
            let tagS = hmac(k_s2c, (server_finished_v3_label, kcctx)) in
            event ServerAuth2SentV3(cpk, spk, sid, secctx, kcctx);
            out(c, (sid, ns, ephs, server_pf, tagS));
            in(c, (=sid, tagC:bitstring));
            if tagC = hmac(k_c2s, (client_finished_v3_label, kcctx)) then
              let completion = completion_hash_v3(kcctx, tagC) in
              let tagAck = hmac(k_complete, (server_complete_v3_label, completion)) in
              event ServerCompleteV3(cpk, spk, sid, secctx, kcctx);
              out(c, (sid, tagAck)).

process
  new csk:skey;
  new ssk:skey;
  new allowed:role;
  let cpk = pk(csk) in
  event TrustedRecordPresent(cpk);
  ((!ClientV3(csk, pk(ssk), allowed)) | (!ServerV3(ssk, cpk, allowed)))
