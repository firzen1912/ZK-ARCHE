{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zk-arche.invalid/schemas/constrained-target-benchmark-manifest.schema.json",
  "title": "ZK-ARCHE constrained-target benchmark evidence manifest",
  "description": "Schema for recording reproducible physical-target evidence. A schema-valid manifest is an evidence container, not proof that measurements were executed or that a target is conformant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_status",
    "repository",
    "target",
    "build",
    "crypto_boundary",
    "entropy_and_keys",
    "platform_security",
    "transport",
    "measurements",
    "lifecycle",
    "dependencies",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_status": {
      "type": "string",
      "enum": ["planned", "measured-unreviewed", "reviewed"]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "branch", "dirty"],
      "properties": {
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "branch": { "type": "string", "minLength": 1 },
        "dirty": { "type": "boolean" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board", "board_revision", "mcu_soc", "cpu", "clock_hz", "ram_bytes", "flash_bytes"],
      "properties": {
        "board": { "type": "string", "minLength": 1 },
        "board_revision": { "type": "string", "minLength": 1 },
        "mcu_soc": { "type": "string", "minLength": 1 },
        "cpu": { "type": "string", "minLength": 1 },
        "clock_hz": { "type": "integer", "minimum": 1 },
        "ram_bytes": { "type": "integer", "minimum": 1 },
        "flash_bytes": { "type": "integer", "minimum": 1 },
        "rtos_or_runtime": { "type": ["string", "null"] }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolchain", "toolchain_version", "profile", "flags", "implementation"],
      "properties": {
        "toolchain": { "type": "string", "minLength": 1 },
        "toolchain_version": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "flags": { "type": "array", "items": { "type": "string" } },
        "implementation": { "type": "string", "enum": ["c", "rust"] }
      }
    },
    "crypto_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["library", "library_version", "acceleration", "software_fallback"],
      "properties": {
        "library": { "type": "string", "minLength": 1 },
        "library_version": { "type": "string", "minLength": 1 },
        "acceleration": { "type": "string", "minLength": 1 },
        "software_fallback": { "type": "boolean" }
      }
    },
    "entropy_and_keys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entropy_source", "health_test_posture", "drbg", "reseed_behavior", "key_generation_mode", "stored_representation", "storage_location", "zeroization_assumptions"],
      "properties": {
        "entropy_source": { "type": "string", "minLength": 1 },
        "health_test_posture": { "type": "string", "minLength": 1 },
        "drbg": { "type": "string", "minLength": 1 },
        "reseed_behavior": { "type": "string", "minLength": 1 },
        "key_generation_mode": { "type": "string", "minLength": 1 },
        "stored_representation": { "type": "string", "minLength": 1 },
        "storage_location": { "type": "string", "minLength": 1 },
        "key_self_test_posture": { "type": ["string", "null"] },
        "zeroization_assumptions": { "type": "string", "minLength": 1 }
      }
    },
    "platform_security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secure_boot", "debug_state", "rollback_assumptions", "clone_assumptions", "reprovision_assumptions"],
      "properties": {
        "secure_boot": { "type": "string", "minLength": 1 },
        "debug_state": { "type": "string", "minLength": 1 },
        "rollback_assumptions": { "type": "string", "minLength": 1 },
        "clone_assumptions": { "type": "string", "minLength": 1 },
        "reprovision_assumptions": { "type": "string", "minLength": 1 }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mtu_bytes", "reliability", "context"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "mtu_bytes": { "type": "integer", "minimum": 1 },
        "reliability": { "type": "string", "minLength": 1 },
        "context": { "type": "string", "minLength": 1 }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wire_bytes", "stack_peak_bytes", "heap_peak_bytes", "static_ram_bytes", "flash_bytes", "latency_us", "cpu_cycles", "sample_count", "raw_artifacts"],
      "properties": {
        "wire_bytes": { "type": "integer", "minimum": 0 },
        "stack_peak_bytes": { "type": "integer", "minimum": 0 },
        "heap_peak_bytes": { "type": "integer", "minimum": 0 },
        "static_ram_bytes": { "type": "integer", "minimum": 0 },
        "flash_bytes": { "type": "integer", "minimum": 0 },
        "latency_us": { "type": "number", "minimum": 0 },
        "cpu_cycles": { "type": "integer", "minimum": 0 },
        "sample_count": { "type": "integer", "minimum": 1 },
        "registry_or_trust_entries": { "type": ["integer", "null"], "minimum": 0 },
        "raw_artifacts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["restart_tested", "replay_state_after_restart", "rollback_tested", "revocation_tested"],
      "properties": {
        "restart_tested": { "type": "boolean" },
        "replay_state_after_restart": { "type": "string", "minLength": 1 },
        "rollback_tested": { "type": "boolean" },
        "revocation_tested": { "type": "boolean" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured_at", "operator", "method", "reviewed_by"],
      "properties": {
        "captured_at": { "type": "string", "format": "date-time" },
        "operator": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "reviewed_by": { "type": ["string", "null"] }
      }
    }
  }
}
