(* ZK-ARCHE secure-association admission symbolic model.
   Scope: the wire-neutral CORE/LINK postcondition in
   spec/core-association-admission.md. This model is non-normative and models
   only decision composition after owning AUTH/TRUST/LINK/BIND subsystems have
   produced their authoritative facts. It does not model cryptographic proof
   soundness, parser correctness, revocation distribution, persistence physics,
   key erasure, transport security, or implementation memory safety. *)

free c: channel.
free cmd_establish: bitstring.
free cmd_trust_mutation: bitstring.
free cmd_revoked: bitstring.
free cmd_other_failure: bitstring.

type evaluation.

(* Preserve a single admission evaluation across mutually exclusive input
   branches; without this precision annotation, the Horn-clause abstraction
   may combine events from separate repetitions of the process. *)
set preciseActions = true.

event AuthComplete(evaluation).
event PreexistingTrustRecord(evaluation).
event AuthorizationPresent(evaluation).
event AuthorizationFresh(evaluation).
event AuthorizationGenerationCurrent(evaluation).
event RevocationCurrent(evaluation).
event HolderNotRevoked(evaluation).
event LineageCurrent(evaluation).
event ReplayContinuityCurrent(evaluation).
event RestartContinuityCurrent(evaluation).
event BindingSatisfied(evaluation).
event RollbackClear(evaluation).
event TrustMutationRequested(evaluation).
event ExplicitRevocationObserved(evaluation).
event AssociationRejected(evaluation).
event AssociationEstablished(evaluation).

(* Establishment is permitted only after every positive prerequisite owned by
   the concrete classifier has been admitted for the same evaluation. *)
query e:evaluation;
  event(AssociationEstablished(e)) ==> event(AuthComplete(e)).

query e:evaluation;
  event(AssociationEstablished(e)) ==> event(PreexistingTrustRecord(e)).

query e:evaluation;
  event(AssociationEstablished(e)) ==> event(AuthorizationPresent(e)).

query e:evaluation;
  event(AssociationEstablished(e)) ==> event(AuthorizationFresh(e)).

query e:evaluation;
  event(AssociationEstablished(e)) ==> event(AuthorizationGenerationCurrent(e)).

query e:evaluation;
  event(AssociationEstablished(e)) ==> event(RevocationCurrent(e)).

query e:evaluation;
  event(AssociationEstablished(e)) ==> event(HolderNotRevoked(e)).

query e:evaluation;
  event(AssociationEstablished(e)) ==> event(LineageCurrent(e)).

query e:evaluation;
  event(AssociationEstablished(e)) ==> event(ReplayContinuityCurrent(e)).

query e:evaluation;
  event(AssociationEstablished(e)) ==> event(RestartContinuityCurrent(e)).

query e:evaluation;
  event(AssociationEstablished(e)) ==> event(BindingSatisfied(e)).

query e:evaluation;
  event(AssociationEstablished(e)) ==> event(RollbackClear(e)).

(* Normal AUTH is NO-LEARNING: an evaluation that requests trust mutation must
   not also establish a security-authoritative association. *)
query e:evaluation;
  event(AssociationEstablished(e)) && event(TrustMutationRequested(e)) ==> false.

(* Explicitly revoked authority state must never compose to establishment. *)
query e:evaluation;
  event(AssociationEstablished(e)) && event(ExplicitRevocationObserved(e)) ==> false.

let AdmissionEvaluation(e:evaluation) =
  in(c, command:bitstring);
  if command = cmd_establish then
    event AuthComplete(e);
    event PreexistingTrustRecord(e);
    event AuthorizationPresent(e);
    event AuthorizationFresh(e);
    event AuthorizationGenerationCurrent(e);
    event RevocationCurrent(e);
    event HolderNotRevoked(e);
    event LineageCurrent(e);
    event ReplayContinuityCurrent(e);
    event RestartContinuityCurrent(e);
    event BindingSatisfied(e);
    event RollbackClear(e);
    event AssociationEstablished(e)
  else if command = cmd_trust_mutation then
    event TrustMutationRequested(e);
    event AssociationRejected(e)
  else if command = cmd_revoked then
    event ExplicitRevocationObserved(e);
    event AssociationRejected(e)
  else if command = cmd_other_failure then
    event AssociationRejected(e).

process
  !(new e:evaluation; AdmissionEvaluation(e))
